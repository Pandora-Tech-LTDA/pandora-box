{
  "name": "Pandora DS",
  "version": "1.1.0",
  "fixed": {
    "font-title": "\"Instrument Sans\", \"Inter\", system-ui, sans-serif",
    "font-body": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "font-mono": "\"JetBrains Mono\", ui-monospace, monospace",
    "text-xs": "11px",
    "text-sm": "12.5px",
